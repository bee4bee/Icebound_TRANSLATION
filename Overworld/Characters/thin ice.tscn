[sub_resource type="GDScript" id=1]
script/source = "extends KinematicBody2D

var tw = Tween.new()
export var hp = 100

var spd = Vector2.ZERO
var force = Vector2.ZERO

func _ready():
	add_child(tw)
	#_dummySpawn_confetti()

func _process(delta):
	hp = 100
	
	spd = ($Position2D.position / 20) * (force)
	move_and_slide(spd, Vector2(0,0), false, 2, 0.360, true)

func _dummySpawn_confetti():
	$Particles2D.emitting = true
	$AnimatedSprite.playing = true
	
	tw.interpolate_property(self, \"modulate:a\", 0, 1, 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property(self, \"position:y\", position.y, position.y - 60, 0.8, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	yield(get_tree().create_timer(0.7, false), \"timeout\")
	tw.interpolate_property(self, \"position:y\", position.y, position.y + 60, 0.4, Tween.TRANS_QUINT, Tween.EASE_IN)
	tw.start()
	
	$yippee.play()
	
	yield(get_tree().create_timer(0.4, false), \"timeout\")
	tw.interpolate_property(self, \"position:y\", position.y, position.y - 20, 0.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	yield(get_tree().create_timer(0.4, false), \"timeout\")
	tw.interpolate_property(self, \"position:y\", position.y, position.y + 20, 0.3, Tween.TRANS_QUINT, Tween.EASE_IN)
	tw.start()
	
	yield(get_tree().create_timer(0.3, false), \"timeout\")
	$AnimatedSprite.playing = false
	$AnimatedSprite.frame = 0


var isImmune = false

var dmgfuncinst = preload(\"res://Archons/DamageFunc/DamageFunc.tscn\")

func _on_Area2D_area_entered(area):
	if area.is_in_group(\"playerAttackArea\") and !isImmune:
		$Position2D.position = ($Area2D.global_position - area.global_position)
		force = (Vector2(48 + 34, 37 + 34) * 2 - Vector2(abs($Position2D.position.x), abs($Position2D.position.y))) * ($Position2D.position / Vector2(abs($Position2D.position.x), abs($Position2D.position.y)))
		print(force)
		print($Position2D.position)
		$Position2D.position = Vector2(abs($Position2D.position.x), abs($Position2D.position.y))
		if $Position2D.position.x < 40.0: force.x *= 4.5
		if $Position2D.position.y < 25.0: force.y *= 4.5
		if $Position2D.position < Vector2(40, 20): 
			$Particles2D2.restart()
			$Particles2D2.emitting = true
			$Star.emitting = true
			$perfecthit.play()
			#PlayerData._tempStop()
			
		if $Position2D.position.x > 85.0 or $Position2D.position.y > 85.0: force /= 2
		
		_takedamagefunc()

func _takedamagefunc():
	isImmune = true
	var dmg = rand_range(15, 35)
	var dmgf = dmgfuncinst.instance()
	#dmgf.rect_position = position - Vector2(0, 45)
	get_parent().add_child(dmgf)
	dmgf.rect_position = position - Vector2(90, 80)
	dmgf._attackReact(dmg)
	
	_push()
	$dmg.play()
	
	$AnimatedSprite.playing = true
	tw.interpolate_property($AnimatedSprite, \"speed_scale\", 1, 0, 2.0, Tween.TRANS_QUAD, Tween.EASE_IN)
	tw.start()
	
	yield(get_tree().create_timer(0.8, false), \"timeout\")
	isImmune = false

func _push():
	tw.interpolate_property($Position2D, \"position\", $Position2D.position, Vector2.ZERO, 1.8, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
"

