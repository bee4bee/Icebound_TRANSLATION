[sub_resource type="GDScript" id=2]
script/source = "extends CanvasLayer


func _input(event):
	if Input.is_action_just_pressed(\"togglefullscreen\") and PlayerData.borderOn:
		if $Border.modulate.a == 1.0 and !OS.window_fullscreen:
			$Border.modulate.a = 0.0
			$BorderFC_tempfix.show()
		if $BorderFC_tempfix.visible and OS.window_fullscreen:
			$Border.modulate.a = 1.0
			$BorderFC_tempfix.hide()
"

