[sub_resource type="GDScript" id=4]
script/source = "extends CanvasLayer

onready var tw = $Tween

var d = true

func _input(event):
	if Input.is_action_just_pressed(\"pause\") and !PlayerData.isInMenu: 
		if get_tree().paused == false:
			get_tree().paused = true
			PlayerData.isPaused = true
			_fadein()
			
			$tapein.playing = true
			
			var x = rand_range(0, 250)
			if x > 249.0: 
				var n = int(rand_range(0, 1.9))
				$Control/Sprite.frame = n
			else: $Control/Sprite.frame = 2
			
			$song.playing = true
			$song.volume_db = -80
			yield(get_tree().create_timer(1.0), \"timeout\")
			tw.interpolate_property($song, \"volume_db\", -80, -6, 3, Tween.TRANS_LINEAR, Tween.EASE_OUT)
			tw.start()
		
		elif d:
			get_tree().paused = false
			_fadeout()
			PlayerData.isPaused = false
			
			$tapein.playing = false
			$song.playing = false
			$song.volume_db = -80
			tw.remove($song, \"volume_db\")

var canExit = true

func _ready():
	$Control/ColorRect2.color.a = 0

func _process(delta):
	pass
	if PlayerData.isPaused and Input.is_action_just_pressed(\"backspace\") and canExit:
		_swap()
		d = false
		set_process(false)
	if !PlayerData.isPaused: $song.volume_db = -80

func _swap():
	SnowdinMusicSingleton._stop_music()
	canExit = false
	tw.interpolate_property($Control/ColorRect2, \"color:a\", 0.0, 1.0, 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	yield(get_tree().create_timer(1.5), \"timeout\")
	PlayerData.isPaused = false
	get_tree().change_scene(\"res://Main Menu/MainMenu.tscn\")

func _fadein():
	tw.remove_all()
	tw.interpolate_property($Control/ColorRect.material, \"shader_param/lod\", 0.0, 1.0, 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Label, \"rect_position:y\", $Control/Label.rect_position.y, 160, 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite, \"position:y\", $Control/Sprite.position.y, 300, 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Label, \"modulate:a\", $Control/Label.modulate.a, 1.0, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite, \"modulate:a\", $Control/Sprite.modulate.a, 1.0, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/ColorRect3, \"color:a\", $Control/ColorRect3.color.a, 0.5, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite2, \"modulate:a\", 0, 1, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite2, \"rect_rotation\", 30, -4, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite3, \"modulate:a\", 0, 1, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite3, \"rect_rotation\", 30, -4, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite2, \"rect_position:y\", $Control/Sprite2.rect_position.y, 400, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite3, \"rect_position:y\", $Control/Sprite3.rect_position.y, 60, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()

func _fadeout():
	tw.remove_all()
	tw.interpolate_property($Control/ColorRect.material, \"shader_param/lod\", 1.0, 0.0, 0.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Label, \"rect_position:y\", $Control/Label.rect_position.y, 160, 0.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite, \"position:y\", $Control/Sprite.position.y, 360, 0.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Label, \"modulate:a\", $Control/Label.modulate.a, 0.0, 0.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite, \"modulate:a\", $Control/Sprite.modulate.a, 0.0, 0.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/ColorRect3, \"color:a\", $Control/ColorRect3.color.a, 0.0, 0.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite2, \"modulate:a\", 1, 0, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite3, \"modulate:a\", 1, 0, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite2, \"rect_position:y\", $Control/Sprite2.rect_position.y, 580, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Control/Sprite3, \"rect_position:y\", $Control/Sprite3.rect_position.y, -120, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
"

[sub_resource type="Shader" id=6]
code = "shader_type canvas_item;

uniform float lod: hint_range(0.0, 5) = 0.0;

void fragment(){
	vec4 color = texture(SCREEN_TEXTURE, SCREEN_UV, lod);
	COLOR = color;
}"

