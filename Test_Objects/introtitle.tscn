[sub_resource type="GDScript" id=3]
script/source = "extends Node2D


var tw = Tween.new()

func _ready():
	add_child(tw)


func _process(delta):
	if Input.is_action_just_pressed(\"ui_accept\"): _thing()

func _thing():
	tw.interpolate_property($Sprite, \"scale\", Vector2.ZERO, Vector2(1, 1), 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	$intro.play()
	
	yield(get_tree().create_timer(2.5), \"timeout\")
	tw.interpolate_property($Sprite, \"position:y\", 240, 225, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	#tw.interpolate_property($Sprite2, \"position:y\", 265, 240, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	#tw.interpolate_property($Sprite2, \"modulate:a\", 0, 1, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	#tw.start()
	tw.interpolate_property($Sprite.material, \"shader_param/whitening\", 0, 1, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	yield(get_tree().create_timer(1.2), \"timeout\")
	$Sprite.hide()
	$Sprite2.modulate.a = 1
	$Camera.flash(2.0)
	$Camera._glitch(0.4, 0.2, 3)
	$chimes.play()
	$Particles2D.emitting = true
	tw.interpolate_property($Sprite2.material, \"shader_param/whitening\", 1, 0, 2.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property($Sprite2, \"rotation_degrees\", -10, 0, 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	yield(get_tree().create_timer(2), \"timeout\")
	
	tw.interpolate_property($Sprite2, \"position:y\", 240, -100, 2.0, Tween.TRANS_QUINT, Tween.EASE_IN)
	tw.start()
"

