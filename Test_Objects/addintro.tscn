[sub_resource type="GDScript" id=3]
script/source = "extends Node2D

var txt = [
	\"Monsterkind and Humanity had a heated war - the Monsters lost, and were sealed underground.\",
	\"However, they were not planning to stay down for long.\",
	\"Through artificial human SOULs, they attempted to break out before the seventh human fell...\",
	\"...but their creation was the downfall of the Underground.\",
	\"However, you already are familiar with this story, are you not?\",
	\"...Let us get to the point.\"
]

onready var ib = $ibpanels
onready var ut = $utpanels
onready var label = $Label

var tw = Tween.new()
var texttw = Tween.new()

var time = 0.0

func _ready():
	add_child(tw)
	add_child(texttw)
	

func _stuff():
	_interptext(0)
	_showpanel(ut)
	yield(get_tree().create_timer(time), \"timeout\")
	_hidepanel(ut)
	yield(get_tree().create_timer(1), \"timeout\")
	ut.frame = 1
	
	_interptext(1)
	_showpanel(ut)
	yield(get_tree().create_timer(time), \"timeout\")
	_hidepanel(ut)
	yield(get_tree().create_timer(1), \"timeout\")
	ut.frame = 2
	
	_interptext(2)
	_showpanel(ib)
	yield(get_tree().create_timer(time), \"timeout\")
	_hidepanel(ib)
	yield(get_tree().create_timer(1), \"timeout\")
	ut.frame = 3
	
	_interptext(3)
	yield(get_tree().create_timer(time), \"timeout\")
	yield(get_tree().create_timer(1), \"timeout\")
	
	_interptext(4)
	tw.interpolate_property($chione, \"modulate:a\", 0, 1, 2.5, Tween.TRANS_QUINT, Tween.EASE_IN)
	tw.start()
	yield(get_tree().create_timer(time), \"timeout\")
	
	_interptext(5)
	$chione.frame = 1
	PlayerData._shakeobj($chione)
	yield(get_tree().create_timer(2), \"timeout\")
	
	$chione.frame = 2
	PlayerData._shakeobj($chione)
	yield(get_tree().create_timer(1), \"timeout\")
	tw.interpolate_property($Camera, \"zoom\", Vector2(1, 1), Vector2(0.4, 0.4), 2, Tween.TRANS_QUINT, Tween.EASE_IN)
	tw.start()
	$Camera.darken_with_set_values(0, 1, 2)

func _hidepanel(obj):
	tw.interpolate_property(obj, \"modulate:a\", 1, 0, 1.0, Tween.TRANS_LINEAR, Tween.EASE_OUT)
	tw.start()

func _showpanel(obj):
	tw.interpolate_property(obj, \"modulate:a\", 0, 1, 1.0, Tween.TRANS_LINEAR, Tween.EASE_OUT)
	tw.start()

func _interptext(nt):
	label.percent_visible = 0.0
	label.text = txt[nt]
	time = 0.06 * len(label.text) + 3.0
	texttw.interpolate_property(label, \"percent_visible\", 0, 1, 0.06 * len(label.text), Tween.TRANS_LINEAR, Tween.EASE_OUT)
	texttw.start()


func _process(delta):
	if Input.is_action_just_pressed(\"ui_accept\"): _stuff()
	if texttw.is_active():
		var pos = label.get_visible_characters()
		if label.text.length() > pos and label.text[pos] != ' ':
			$Blitter_Sound.play()
			$Blitter_Sound.pitch_scale = rand_range(0.98, 1.02)
"

