[gd_scene load_steps=4 format=2]

[ext_resource path="res://determination-mono-web-font/DeterminationMonoWebRegular-Z5oq.ttf" type="DynamicFontData" id=1]

[sub_resource type="GDScript" id=2]
script/source = "extends Node2D

onready var text = $RichTextLabel

var node = Node2D.new()
func _ready():
	add_child(node)


func _process(delta):
	if Input.is_action_just_pressed(\"ui_accept\"):
		_break()
		_move()

func _break():
	for i in text.get_total_character_count():
		var label = text.duplicate()
		node.add_child(label)
		label.text = text.bbcode_text[i]
		label.rect_position.x = 0 + i * text.get_font(\"normal_font\").size / 2

func _move():
	for i in 80:
		for j in node.get_children():
			j.rect_position.y += float(i) / 4
		yield(get_tree().create_timer(0.04),\"timeout\")
"

[sub_resource type="DynamicFont" id=1]
