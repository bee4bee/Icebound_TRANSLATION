[application]

config/name="Icebound"
run/main_scene="res://Cutscenes/Intro_Story.tscn"
boot_splash/show_image=false
boot_splash/use_filter=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://soulicon.png"
config/windows_native_icon="res://elsav2soul.ico"

[autoload]

SnowdinMusicSingleton="*res://Singletons/SnowdinMusicSingleton.tscn"
PlayerData="*res://Singletons/Player_Data.tscn"
SoulPositionSingleton="*res://Singletons/SoulPositionSingleton.tscn"
Border="*res://Singletons/Border.tscn"
RichPresence="*res://Singletons/rich_presence/rich_presence.tscn"
AudioBank="*res://Singletons/AudioBank.tscn"
Discord="*res://addons/discord_game_sdk/discord.gd"

[debug]

settings/fps/force_fps=60
settings/stdout/print_fps=true

[display]

window/size/width=700
window/size/height=480
window/size/resizable=false
window/size/test_width=700
window/size/test_height=480
window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PoolStringArray( "res://addons/discord_game_sdk/plugin.cfg" )

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": true,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

