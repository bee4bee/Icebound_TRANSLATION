script/source = "extends Node2D

onready var blitter = $Blitter
onready var cam = $Camera

var tween = Tween.new()
var tw = Tween.new()

var index = 0.0
var canSkip = true

var dialogue = [
	'Троица идёт в Водопадье, которое превратилось в безлюдную пустошь.',
	'Сильные метели уносят остатки земли, которые когда-то кипели жизнью.',
	\"По мере того как путники продвигаются вперед, позади них крадётся крошечный цветок...\",
	'...',
	\"Разросшиеся лозы преграждают им путь, пытаясь загнать всех в угол.\",
	\"Всё пошло не по плану. Он разлучил троицу, но не так, как хотел...\",
	\"...оставив восьмого Человека в одиночестве.\",
	\"Когда цветок нападает, Папирус ловит приближающуюся лозу...\",
	\"...вырывая её из земли, он потянул цветок за собой.\",
	\"И лишь спустя несколько мгновений тот швырнул его на ребристую землю.\",
	\"Папирус колдует топор, но цветок сбегает.\",
	\"Восьмой Человек был вынужден сделать то же самое.\"
]

func _ready():
	add_child(tween)
	add_child(tw)
	_scene_set()
	$music.play()
	

func _process(delta):
	#if Input.is_action_just_pressed(\"ui_accept\"): _scene_set()
	if tween.is_active():
		var pos = blitter.get_visible_characters()
		
		var getchar = blitter.text[blitter.visible_characters]
		if getchar != ' ' or getchar != '.' or getchar != ',':
			$chatter_fx.play()


func _input(event):
	if Input.is_action_just_pressed(\"cutsceneskip\"): 
		set_process(false)
		_skip()


func _scene_set():
	
	for i in range(0, 12):
		_create_text(dialogue[i])
		match i:
			0: _scene_0_4()
			4: _scene_5_7()
			7: _scene_8_10()
			10: _scene_11_12()
		yield(get_tree().create_timer(len(blitter.text) * 0.06 + 3.0, false), \"timeout\")
	
	_skip()
	
func _create_text(text):
	blitter.text = text
	blitter.percent_visible = 0.0
	blitter.modulate.a = 1.0
	tween.interpolate_property(
		blitter, \"percent_visible\",
		0.0, 1.0, len(text) * 0.06,
		Tween.TRANS_LINEAR, Tween.EASE_OUT
	)
	tween.start()

func _fade_scene(node):
	tw.interpolate_property(
		blitter, \"modulate:a\",
		1.0, 0.0, 1.0,
		Tween.TRANS_LINEAR, Tween.EASE_IN
	)
	tw.interpolate_property(
		node, \"modulate:a\",
		node.modulate.a, 0.0, 1.2,
		Tween.TRANS_LINEAR, Tween.EASE_IN
	)
	tw.start()

func _skip():
	$Camera.darken_with_set_values(0.0, 1.0, 2.0)
	tw.interpolate_property($chatter_fx, \"volume_db\", 0.0, -80.0, 2.0, Tween.TRANS_LINEAR, Tween.EASE_OUT)
	tw.interpolate_property($music, \"volume_db\", 0.0, -80.0, 2.0, Tween.TRANS_LINEAR, Tween.EASE_OUT)
	tw.start()
	yield(get_tree().create_timer(2.2, false),\"timeout\")
	get_tree().change_scene(\"res://Overworld/Rooms/WaterfallChamber1.tscn\")


func _scene_0_4():
	var bg = $\"Panel0-4/bg\"
	var pap = $\"Panel0-4/pap\"
	var chione = $\"Panel0-4/chione\"
	var frisk = $\"Panel0-4/frisk\"
	var flowey = $\"Panel0-4/flowey\"
	var scene = $\"Panel0-4\"
	var particle = $\"Panel0-4/Particles2D\"
	if PlayerData.addParticles: particle.emitting = true
	_tweenbase(bg, 35, 2.0)
	yield(get_tree().create_timer(1.5, false),\"timeout\")
	_tweenbase(pap, 35, 1.5)
	yield(get_tree().create_timer(1.0, false),\"timeout\")
	_tweenbase(chione, 35, 1.5)
	yield(get_tree().create_timer(1.0, false),\"timeout\")
	_tweenbase(frisk, 35, 1.5)
	_tweenbase(particle, 0, 4.0)
	yield(get_tree().create_timer(10.0, false),\"timeout\")
	tw.interpolate_property(scene, \"position:x\", scene.position.x, 80, Tween.TRANS_QUINT, Tween.EASE_IN_OUT)
	tw.start()
	yield(get_tree().create_timer(2.0, false),\"timeout\")
	_tweenbase(flowey, -45, 1.5)
	yield(get_tree().create_timer(4.0, false),\"timeout\")
	tw.interpolate_property(scene, \"modulate:a\", 1.0, 0.0, 2.0, Tween.TRANS_LINEAR, Tween.EASE_OUT)
	tw.start()

func _scene_5_7():
	var pap = $\"Panel5-7/pap\"
	var frisk = $\"Panel5-7/frisk\"
	var chione = $\"Panel5-7/chione\"
	var flowey = $\"Panel5-7/fl\"
	var bg = $\"Panel5-7/bg\"
	
	_tweenbase(bg, 0, 1.5)
	yield(get_tree().create_timer(0.3, false),\"timeout\")
	_tweenbase(flowey, 20, 1.5)
	yield(get_tree().create_timer(0.3, false),\"timeout\")
	_tweenbase(frisk, -40, 1.5)
	yield(get_tree().create_timer(0.3, false),\"timeout\")
	_tweenbase(pap, -30, 1.5)
	yield(get_tree().create_timer(0.3, false),\"timeout\")
	_tweenbase(chione, 40, 1.5)
	
	yield(get_tree().create_timer(7.0, false),\"timeout\")
	tw.interpolate_property($\"Panel5-7\", \"modulate:a\", 1.0, 0.0, 2.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()

func _scene_8_10():
	yield(get_tree().create_timer(2.0, false),\"timeout\")
	var bg = $\"Panel8-10/Sprite\"
	var one = $\"Panel8-10/1\"
	var two = $\"Panel8-10/2\"
	var three = $\"Panel8-10/3\"
	_tweenbase(bg, 20, 2)
	_tweenbase(one, -20, 2)
	
	yield(get_tree().create_timer(5.0, false),\"timeout\")
	_tweenbase(two, 20, 1)
	tw.interpolate_property(one, \"modulate:a\", 1, 0, 1, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property(one, \"position:x\", one.position.x, one.position.x + 20, 1, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	yield(get_tree().create_timer(4.0, false),\"timeout\")
	_tweenbase(three, -20, 1)
	tw.interpolate_property(two, \"modulate:a\", 1, 0, 1, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property(two, \"position:x\", two.position.x, two.position.x + 20, 1, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	yield(get_tree().create_timer(3.0, false),\"timeout\")
	tw.interpolate_property($\"Panel8-10\", \"modulate:a\", 1, 0, 1.5, Tween.TRANS_QUINT, Tween.EASE_IN)
	tw.start()

func _scene_11_12():
	var pap = $\"Panel11-12/pap\"
	var flowey = $\"Panel11-12/flowey\"
	_tweenbase(pap, 40, 1.5)
	yield(get_tree().create_timer(1.0, false),\"timeout\")
	_tweenbase(flowey, -40, 1.5)
	yield(get_tree().create_timer(1.5, false),\"timeout\")
	cam._flash_dark(0.4)
	yield(get_tree().create_timer(0.4, false),\"timeout\")
	cam._cam_beat(0.15)
	cam.flash(1.5)
	pap.frame = 1
	flowey.frame = 1
	yield(get_tree().create_timer(3.0, false),\"timeout\")
	tw.interpolate_property($\"Panel11-12\", \"modulate:a\", 1.0, 0.0, 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
func _tweenbase(node, pos, time):
	tw.interpolate_property(node, \"position:x\", node.position.x - pos, node.position.x, time, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property(node, \"modulate:a\", 0.0, 1.0, time, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
"

