[sub_resource type="GDScript" id=2]
script/source = "extends Node2D


var tw = Tween.new()
onready var logo = $Sprite
onready var text = $Label

func _ready():
	pass

func _process(delta):
	if Input.is_action_just_pressed(\"ui_accept\"):
		text.modulate.a = 0
		add_child(tw)
		tw.interpolate_property(logo, \"scale\", Vector2.ZERO, Vector2(2.5, 2.5), 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
		tw.start()
		$AudioStreamPlayer.play()
		yield(get_tree().create_timer(3.0), \"timeout\")
		tw.interpolate_property(text, \"modulate:a\", 0, 1, 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
		tw.start()
		yield(get_tree().create_timer(3.0), \"timeout\")
		tw.interpolate_property(self, \"modulate:a\", 1, 0, 1.5, Tween.TRANS_QUINT, Tween.EASE_IN_OUT)
		tw.start()
"

