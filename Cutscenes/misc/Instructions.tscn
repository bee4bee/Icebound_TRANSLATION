[gd_scene load_steps=5 format=2]

[ext_resource path="res://Camera/Camera.tscn" type="PackedScene" id=1]
[ext_resource path="res://determination-mono-web-font/DeterminationSansWebRegular-369X.ttf" type="DynamicFontData" id=2]

[sub_resource type="GDScript" id=2]
script/source = "extends Node2D

var tw = Tween.new()
onready var tx = $Label

func _ready():
	add_child(tw)
	tw.interpolate_property(tx, \"modulate:a\", 0, 1, 1, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property(tx, \"rect_position:y\", tx.rect_position.y + 40, tx.rect_position.y, 1, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()

var cantrans = true

func _process(delta):
	if Input.is_action_just_pressed(\"ui_accept\") and cantrans:
		cantrans = false
		tw.interpolate_property(tx, \"modulate:a\", 1, 0, 1, Tween.TRANS_QUINT, Tween.EASE_OUT)
		tw.interpolate_property(tx, \"rect_position:y\", tx.rect_position.y, tx.rect_position.y + 40, 1, Tween.TRANS_QUINT, Tween.EASE_OUT)
		tw.start()
		yield(get_tree().create_timer(2.0), \"timeout\")
		get_tree().change_scene(\"res://NameSelection/NameSelection.tscn\")
"

