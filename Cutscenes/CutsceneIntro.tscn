[sub_resource type="GDScript" id=2]
script/source = "extends Node2D

# Connect it to Intro_Story.tscn after the last panels fade



var tw = Tween.new()

onready var spr = $AnimatedSprite
onready var cam = $Camera

func _ready():
	add_child(tw)
	_anim()


func _anim():
	tw.interpolate_property(cam, \"zoom\", Vector2(0.4, 0.4), Vector2(1, 1), 3.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.interpolate_property(cam, \"position:y\", -100, 240, 3.6, Tween.TRANS_QUINT, Tween.EASE_IN_OUT)
	cam.darken_with_set_values(1.0, 0.0, 3.0)
	tw.interpolate_property(spr, \"position:y\", -300, 320, 2.6, Tween.TRANS_QUINT, Tween.EASE_IN)
	tw.start()
	
	yield(get_tree().create_timer(2.6, false),\"timeout\")
	spr.frame = 0
	_shakeobj(spr)
	$fx2.play()
	$Particles2D.emitting = true
	
	yield(get_tree().create_timer(1.5, false),\"timeout\")
	cam.darken_with_set_values(0.0, 1.0, 3.0)
	yield(get_tree().create_timer(4.0, false),\"timeout\")
	#get_tree().change_scene(\"res://Main Menu/MainMenu.tscn\")


func _shakeobj(object):
	for i in 6.0:
		if i % 2 == 0: object.position.x += (5.0 - i) * 1.2
		else: object.position.x -= (5.0 - i) * 1.2
		yield(get_tree().create_timer(0.07, false),\"timeout\")
"

