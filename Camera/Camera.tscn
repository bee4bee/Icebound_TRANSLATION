[sub_resource type="Shader" id=43]
code = "shader_type canvas_item;
//2D (returns 0 - 1)
float random2d(vec2 n) { 
    return fract(sin(dot(n, vec2(12.9898, 4.1414))) * 43758.5453);
}

float randomRange (in vec2 seed, in float min, in float max) {
        return min + random2d(seed) * (max - min);
}

// return 1 if v inside 1d range
float insideRange(float v, float bottom, float top) {
   return step(bottom, v) - step(top, v);
}

//inputs
uniform float amt: hint_range(0.0, 1) = 0.2;
uniform float speed: hint_range(0.0, 1) = 0.5; //0 - 1 speed
   
void fragment()
{
    
    float time = floor(TIME * speed * 60.0);
    
    //copy orig
    vec3 outCol = texture(SCREEN_TEXTURE, SCREEN_UV).rgb;
    
    //randomly offset slices horizontally
    float maxOffset = amt/2.0;
    for (float i = 0.0; i < 10.0 * amt; i += 1.0) {
        float sliceY = random2d(vec2(time , 2345.0 + float(i)));
        float sliceH = random2d(vec2(time , 9035.0 + float(i))) * 0.25;
        float hOffset = randomRange(vec2(time , 9625.0 + float(i)), -maxOffset, maxOffset);
        vec2 uvOff = SCREEN_UV;
        uvOff.x += hOffset;
        if (insideRange(SCREEN_UV.y, sliceY, fract(sliceY+sliceH)) == 1.0 ){
            outCol = texture(SCREEN_TEXTURE, uvOff).rgb;
        }
    }
    
    //do slight offset on one entire channel
    float maxColOffset = amt/6.0;
    float rnd = random2d(vec2(time , 9545.0));
    vec2 colOffset = vec2(randomRange(vec2(time , 9545.0),-maxColOffset,maxColOffset), 
    randomRange(vec2(time , 7205.0),-maxColOffset,maxColOffset));
    if (rnd < 0.33){
        outCol.r = texture(SCREEN_TEXTURE, SCREEN_UV + colOffset).r;
        
    }else if (rnd < 0.66){
        outCol.g = texture(SCREEN_TEXTURE, SCREEN_UV + colOffset).g;
        
    } else{
        outCol.b = texture(SCREEN_TEXTURE, SCREEN_UV + colOffset).b;  
    }
       
    COLOR = vec4(outCol,1.0);
}"

