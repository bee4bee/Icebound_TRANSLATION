[sub_resource type="GDScript" id=1]
script/source = "extends Node2D

onready var sprite = $AnimatedSprite
onready var cone = $AnimatedSprite/Cone
onready var pointed = $AnimatedSprite/Cone/refpose
onready var circle = $AnimatedSprite/Circle
onready var area = $area
var pellet = preload(\"res://Bullets/Pellet/Pellet.tscn\")
var thorn = preload(\"res://Bullets/Thorn/Thorn.tscn\")

onready var main = get_node(\"/root/Battle_Engine\")

var b

var tw = Tween.new()

func _ready():
	add_child(tw)

func _spawn(pos1, pos2, type, num):
	tw.interpolate_property(self, \"modulate:a\", 0, 1, 0.6, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	position = pos1
	tw.interpolate_property(self, \"position\", pos1, pos2, 0.6, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	yield(get_tree().create_timer(0.6), \"timeout\")
	if type == \"cone\": _cone(num)
	if type == \"circle\": _circle(num)
	if type == \"moveFirst\": 
		#yield(get_tree().create_timer(1.2), \"timeout\")
		$Particles2D2.emitting = true
	AudioBank._flash()

func _cone(amt):
	cone.look_at(SoulPositionSingleton.soulPosition)
	#cone.rotation += PI/4
	tw.interpolate_property(cone, \"modulate:a\", 1.0, 0.0, 0.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	yield(get_tree().create_timer(0.75), \"timeout\")
	sprite.play(\"blast\")
	sprite.scale *= 1.5
	AudioBank._explode()
	$Particles2D.emitting = false
	for i in amt:
		b = pellet.instance()
		add_child(b)
		b.scale = Vector2(0.6, 0.6)
		var angle = rand_range(0.0, PI * 2)
		var d = rand_range(20.0, 50.0)
		tw.interpolate_property(b, \"global_position\", b.global_position, pointed.global_position + Vector2(cos(angle) * d, sin(angle) * d * 1.2), 2.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	yield(get_tree().create_timer(0.6, false), \"timeout\")
	tw.interpolate_property(self, \"modulate:a\", 1, 0, 0.6, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	yield(get_tree().create_timer(0.3, false), \"timeout\")
	queue_free()

func _circle(amt):
	tw.interpolate_property(circle, \"modulate:a\", 1.0, 0.0, 0.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	yield(get_tree().create_timer(0.75, false), \"timeout\")
	sprite.play(\"blast\")
	sprite.scale *= 1.5
	AudioBank._explode()
	$Particles2D.emitting = false
	area.rotation_degrees = rand_range(0.0, 360.0)
	for i in amt:
		b = pellet.instance()
		area.add_child(b)
		b.scale = Vector2(0.6, 0.6)
		var angle = PI * 2 - (PI * 2 / (amt + rand_range(-0.5, 0.5))) * i
		var x = rand_range(65, 80)
		tw.interpolate_property(b, \"global_position\", b.global_position, b.global_position + Vector2(cos(angle) * x, sin(angle) * x), 1.5, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	yield(get_tree().create_timer(0.6, false), \"timeout\")
	tw.interpolate_property(self, \"modulate:a\", 1, 0, 0.6, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	yield(get_tree().create_timer(0.33, false), \"timeout\")
	queue_free()

func _start_homingSet(point, distance, amt, atk, delay, delayDodge, speed, timeUntilUnHoming):
	for i in amt:
		var x = rand_range(0, 2*PI)
		if atk[i] == true:
			b = thorn.instance()
			main.add_child(b)
			b._spawn(self.global_position, speed, timeUntilUnHoming)
		tw.interpolate_property(self, \"position\", self.position, point + Vector2(cos(x) * distance, sin(x) * distance), 0.6, Tween.TRANS_QUINT, Tween.EASE_OUT)
		tw.start()
		if atk[i] == true: yield(get_tree().create_timer(delay, false), \"timeout\")
		else: yield(get_tree().create_timer(delayDodge), \"timeout\")
	
	var x = rand_range(0, 2*PI)
	tw.interpolate_property(self, \"position\", self.position, point + Vector2(cos(x) * distance, sin(x) * distance), 0.6, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	yield(get_tree().create_timer(delayDodge), \"timeout\")
	_cone(4)
"

