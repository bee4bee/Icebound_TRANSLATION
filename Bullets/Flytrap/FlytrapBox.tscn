[sub_resource type="GDScript" id=3]
script/source = "extends Node2D

var tw = Tween.new()

func _ready():
	add_child(tw)

onready var main = get_node(\"/root/Battle_Engine\")
var fly = preload(\"res://Bullets/Flytrap/FlyBox.tscn\")

func _cast(pos, time):
	position.y = pos.y + 100
	position.x = pos.x
	tw.interpolate_property(self, \"position:y\", position.y, pos.y - 60, 1.0, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	$chainpull.play()
	
	yield(get_tree().create_timer(0.8, false), \"timeout\")
	
	
	tw.remove_all()
	tw.interpolate_property(self, \"position:y\", position.y, pos.y, 0.7, Tween.TRANS_QUINT, Tween.EASE_IN)
	tw.start()
	
	yield(get_tree().create_timer(0.7, false), \"timeout\")
	$AnimatedSprite.playing = true
	PlayerData._shakeobj(self)
	
	$chainpull.playing = false
	$land.play()
	
	for i in time / 0.4:
		_spawning()
		yield(get_tree().create_timer(0.4, false), \"timeout\")
	
	yield(get_tree().create_timer(2.6, false), \"timeout\")
	$AnimatedSprite.playing = false
	$AnimatedSprite.frame = 2
	$close.play()
	PlayerData._shakeobj(self)
	yield(get_tree().create_timer(0.8, false), \"timeout\")
	_burst()
	PlayerData._shakeobj(self)
	$AnimatedSprite.frame = 0
	tw.interpolate_property(self, \"position:y\", position.y, position.y + 100, 5.0, Tween.TRANS_QUINT, Tween.EASE_IN)
	tw.start()
	

func _spawning():
	var b = fly.instance()
	main.add_child(b)
	
	b.endpos = 420.0
	b.position = Vector2(320 + rand_range(-200, 200), 100 + rand_range(-30, 30))
	
	tw.interpolate_property(b, \"position\", b.position, b.position + Vector2(rand_range(-40, 40), rand_range(-40, 40)), 0.6, Tween.TRANS_QUINT, Tween.EASE_OUT)
	tw.start()
	
	yield(get_tree().create_timer(0.6, false), \"timeout\")
	b.canSway = true
	tw.interpolate_property(b, \"position\", b.position, Vector2(320, 420), 2.3, Tween.TRANS_LINEAR, Tween.EASE_OUT)
	tw.start()

func _burst():
	for i in 16:
		var b = fly.instance()
		main.add_child(b)
		b.position = Vector2(320, 420)
		b.endpos = 700
		b.canSway = true
		b.rot = rand_range(PI/2 - PI/5, PI/2 + PI/5) + PI/2
		b.canmovedir = true
		yield(get_tree().create_timer(0.15, false), \"timeout\")
"

