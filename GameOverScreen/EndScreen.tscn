[sub_resource type="Shader" id=12]
code = "shader_type canvas_item;

uniform float height = 2.4;
uniform float speed = 1.5
;
uniform float frequency = 8.0;

void vertex() {
	VERTEX.y += sin((frequency * UV.x) + (TIME * speed)) * height;
}"

