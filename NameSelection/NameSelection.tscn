frames = SubResource( 15 )

[node name="vorprize" type="RichTextLabel" parent="."]
visible = false
modulate = Color( 0.121569, 0.133333, 0.176471, 1 )
margin_left = -30.0
margin_top = -26.0
margin_right = 716.0
margin_bottom = 560.0
size_flags_horizontal = 0
size_flags_vertical = 4
custom_fonts/normal_font = SubResource( 1 )
bbcode_enabled = true
bbcode_text = "Посмотрите на них, они приходят сюда, зная, что нечисты. Тенно используют ключи, но они всего лишь нарушители. Только я, Вор, знаю истинную силу Пустоты. Меня разрезали пополам, уничтожили, но через свой Ключ Януса Пустота призвала меня. Она привела меня сюда, и здесь я возродился. Мы не можем винить этих существ, ими руководит лжепророк, самозванец, не знающий секретов Пустоты. Вот Тенно, пришедшие, чтобы осквернить и осквернить это священное царство. Братья мои, разве я не говорил об этом дне? Разве я не предсказывал этот момент? Теперь я остановлю их. Теперь я изменился, возродился благодаря энергии Ключа Януса. Навечно связан с Пустотой. Пусть все знают, если Тенно хотят истинного спасения, они сложат оружие и будут ждать крещения моим Ключом Януса. Пришло время. Я научу этих нарушителей искупительной силе моего Ключа Януса. Они поймут эту простую истину. Тенно заблудились, и они будут сопротивляться. Но я, Вор, очистлю это место от их нечистоты."
text = "Посмотрите на них, они приходят сюда, зная, что нечисты. Тенно используют ключи, но они всего лишь нарушители. Только я, Вор, знаю истинную силу Пустоты. Меня разрезали пополам, уничтожили, но через свой Ключ Януса Пустота призвала меня. Она привела меня сюда, и здесь я возродился. Мы не можем винить этих существ, ими руководит лжепророк, самозванец, не знающий секретов Пустоты. Вот Тенно, пришедшие, чтобы осквернить и осквернить это священное царство. Братья мои, разве я не говорил об этом дне? Разве я не предсказывал этот момент? Теперь я остановлю их. Теперь я изменился, возродился благодаря энергии Ключа Януса. Навечно связан с Пустотой. Пусть все знают, если Тенно хотят истинного спасения, они сложат оружие и будут ждать крещения моим Ключом Януса. Пришло время. Я научу этих нарушителей искупительной силе моего Ключа Януса. Они поймут эту простую истину. Тенно заблудились, и они будут сопротивляться. Но я, Вор, очистлю это место от их нечистоты.."
scroll_active = false

